<!doctype html>
<html lang="{{ site.lang | default: 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ page.title }} | {{ site.first_name }} {{ site.last_name }}</title>
    <meta name="description" content="{{ page.description | default: site.description | strip_html | strip_newlines | escape }}">
    {% assign asset_version = site.time | date: '%s' %}
    <link rel="icon" type="image/svg+xml" href="{{ '/assets/img/favicon.svg' | relative_url }}?v={{ asset_version }}">
    <link
      rel="preload"
      as="image"
      href="{{ '/assets/img/paper-background-zine-v1.webp' | relative_url }}"
      type="image/webp"
      fetchpriority="high"
    >
    <link
      rel="preload"
      as="image"
      href="{{ '/assets/img/me/jungfraujoch-1440.webp' | relative_url }}"
      type="image/webp"
      imagesrcset="{{ '/assets/img/me/jungfraujoch-960.webp' | relative_url }} 960w, {{ '/assets/img/me/jungfraujoch-1440.webp' | relative_url }} 1440w"
      imagesizes="(max-width: 800px) calc(100vw - 2rem), (max-width: 968px) calc(100vw - 2.5rem), 928px"
    >
    <link
      rel="preload"
      as="image"
      href="{{ '/assets/img/me/mountain-selfie-1920.webp' | relative_url }}"
      type="image/webp"
      imagesrcset="{{ '/assets/img/me/mountain-selfie-960.webp' | relative_url }} 960w, {{ '/assets/img/me/mountain-selfie-1920.webp' | relative_url }} 1920w"
      imagesizes="(max-width: 800px) calc(100vw - 2rem), (max-width: 968px) calc(100vw - 2.5rem), 928px"
    >
    <link rel="stylesheet" href="{{ '/assets/css/bio.css' | relative_url }}?v={{ asset_version }}">
    {% include analytics.liquid %}
  </head>
  <body class="photo-body">
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <nav class="primary-navigation" aria-label="Primary navigation">
        <a class="site-mark" href="{{ '/' | relative_url }}" aria-label="Xinlong Du, home">
          <span class="site-mark-label">Home</span>
        </a>
        <a href="{{ '/' | relative_url }}#projects-title">Projects</a>
      </nav>
      <nav aria-label="Site navigation">
        <a href="mailto:{{ site.data.socials.email }}">Email</a>
      </nav>
    </header>

    <main id="main" class="bio-shell photo-shell">
      <section class="photo-page" aria-label="Photos of Xinlong Du">
        <div class="photo-stack">
          {{ content }}
        </div>
      </section>
    </main>
  </body>
</html>
