<!doctype html>
<html lang="{{ site.lang | default: 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ page.title | escape }} | {{ site.first_name }} {{ site.last_name }}</title>
    <meta name="description" content="{{ page.description | default: site.description | strip_html | strip_newlines | escape }}">
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    {% assign asset_version = site.time | date: '%s' %}
    <link rel="icon" type="image/svg+xml" href="{{ '/assets/img/favicon.svg' | relative_url }}?v={{ asset_version }}">
    <link rel="preload" as="image" href="{{ '/assets/img/paper-background-zine-v1.webp' | relative_url }}" type="image/webp" fetchpriority="high">
    <link rel="stylesheet" href="{{ '/assets/css/bio.css' | relative_url }}?v={{ asset_version }}">
    {% include analytics.liquid %}
    {% if page.math %}
      {% include mathjax.liquid %}
    {% endif %}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <nav class="primary-navigation" aria-label="Primary navigation">
        <a class="site-mark" href="{{ '/' | relative_url }}" aria-label="Xinlong Du, home">
          <span class="site-mark-label">Home</span>
        </a>
        <a href="{{ '/' | relative_url }}#projects-title">Projects</a>
        <a href="{{ '/' | relative_url }}#blog-title">Blog</a>
      </nav>
      <nav aria-label="Site navigation">
        <a href="mailto:{{ site.data.socials.email }}">Email</a>
      </nav>
    </header>

    <main id="main" class="bio-shell blog-post-shell">
      <article>
        <header class="blog-post-header">
          <p class="section-label">Blog</p>
          <h1>{{ page.title }}</h1>
          <p class="blog-meta"><time datetime="{{ page.date | date: '%Y-%m-%d' }}">{{ page.date | date: '%B %-d, %Y' }}</time></p>
        </header>

        <div class="blog-content">
          {{ content }}
        </div>

        <footer class="blog-post-footer">
          <a class="bio-text-link" href="{{ '/' | relative_url }}#blog-title">Back to blog</a>
        </footer>
      </article>
    </main>
  </body>
</html>
