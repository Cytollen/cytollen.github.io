<!doctype html>
<html lang="{{ site.lang | default: 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ site.first_name }} {{ site.last_name }}</title>
    <meta name="description" content="{{ site.description | strip_html | strip_newlines | escape }}">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg'/%3E">
    {% assign asset_version = site.time | date: '%s' %}
    <link rel="stylesheet" href="{{ '/assets/css/bio.css' | relative_url }}?v={{ asset_version }}">
    <script defer src="{{ '/assets/js/bio-hopfield.js' | relative_url }}?v={{ asset_version }}"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <a class="site-mark" href="{{ '/' | relative_url }}">XD</a>
      <nav aria-label="Site navigation">
        <a href="mailto:{{ site.data.socials.email }}">Email</a>
      </nav>
    </header>

    <main id="main" class="bio-shell">
      <section class="bio-intro" aria-labelledby="bio-title">
        <figure class="hopfield-panel">
          <canvas
            id="hopfield-name"
            class="hopfield-canvas"
            aria-label="An interactive binary Hopfield network recalling the name Xinlong Du"
          ></canvas>
          <figcaption>
            <span>
              <a href="https://en.wikipedia.org/wiki/Hopfield_network" target="_blank" rel="noopener">
                binary Hopfield network
              </a>
            </span>
            <span class="hopfield-controls" aria-label="Hopfield controls">
              <button type="button" data-hopfield-action="shuffle">Shuffle</button>
              <button type="button" data-hopfield-action="clear">Clear</button>
            </span>
            <span id="hopfield-status" class="hopfield-status">initializing</span>
          </figcaption>
        </figure>

        <div class="bio-copy">
          <h1 id="bio-title" class="screen-reader-only">Xinlong Du</h1>
          <p class="lede">
            I am a PhD student in Industrial Engineering at Purdue University, advised by Prof. Harsha Honnappa. I work on uncertainty, stochastic systems, and decision-making.
          </p>
          <p class="bio-sublede">
            Before that, I studied statistics at Purdue and physics at Reed College.
          </p>
        </div>
      </section>

      <section class="bio-grid" aria-label="Bio details">
        <div class="bio-block">
          <h2>Now</h2>
          <p>
            Thinking about stochastic models for point processes and how to make meaningful inferences on their latent structures.
          </p>
        </div>
        <div class="bio-block">
          <h2>Before</h2>
          <p>
            BA in Physics from Reed College and MS in Statistics from Purdue University.
          </p>
        </div>
        <div class="bio-block">
          <h2>Outside</h2>
          <p>
            Classical music, tennis, biking, and other things that keep the mind from turning into a spreadsheet.
          </p>
        </div>
      </section>

      <section class="project-section" aria-labelledby="projects-title">
        <p class="section-label">Projects</p>
        <article class="project-item">
          <div class="project-copy">
            <p class="project-meta">2024-25 / R package</p>
            <h2 id="projects-title">SimBaRepro</h2>
            <p>
              Simulation-based, finite-sample inference for privatized data. I worked with Prof. Jordan Awan and Zhanyu Wang to turn their research paper into an R package published on CRAN.
            </p>
            <div class="project-actions" aria-label="SimBaRepro links">
              <a href="https://cran.r-project.org/web/packages/SimBaRepro/index.html">CRAN</a>
              <a href="https://www.tandfonline.com/doi/full/10.1080/01621459.2024.2427436">Paper</a>
              <a href="{{ '/projects/1_project/' | relative_url }}">Details</a>
            </div>
          </div>
          <a class="project-figure" href="https://cran.r-project.org/web/packages/SimBaRepro/index.html" aria-label="Open SimBaRepro on CRAN">
            <img
              src="{{ '/assets/img/package_figures/package_illustration.png' | relative_url }}"
              alt="Illustration of simulation-based inference for privatized data"
              loading="lazy"
            >
          </a>
        </article>
      </section>

    </main>
  </body>
</html>
